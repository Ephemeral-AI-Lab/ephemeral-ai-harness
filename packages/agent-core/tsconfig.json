{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    // pi-ai's provider SDK bundle contains optional peer declarations that
    // are not resolvable under pnpm's isolated layout. Application sources
    // remain fully typechecked while vendor declarations are trusted.
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "testkit/**/*.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts"
  ],
  "exclude": ["**/node_modules"]
}
