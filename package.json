{
  "name": "@ephai/agent-harness",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "pnpm -r run check",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @ephai/agent-core run test:e2e",
    "test:live": "pnpm --filter @ephai/agent-core run test:live"
  }
}
